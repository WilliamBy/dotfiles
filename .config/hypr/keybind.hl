### KEYBINDINGSS ###
####################

# See https://wiki.hyprland.org/Configuring/Keywords/
$Mod = SUPER # Sets "Windows" key as main modifier
$Shift = SUPER SHIFT
$CTRL = SUPER CTRL
$SuperMod = SUPER SHIFT CTRL

# Apps
$fileManager = alacritty -e ranger
$netmgr = alacritty -e nmtui
$taskmgr = alacritty -e btm
$launcher = rofi -show drun
$dmenu = rofi -show run
$terminal = kitty
$locker = hyprlock
$editor = neovide

# Example binds, see https://wiki.hyprland.org/Configuring/Binds/ for more
bind = $Mod, Return, exec, $terminal
bind = $Mod, Q, killactive,
bind = $Mod SHIFT, M, exit,
bind = $Mod, E, exec, $fileManager
bind = $Mod, Space, togglefloating,
bind = $Mod, R, exec, $launcher
bind = $Mod, D, exec, $dmenu
bind = $Mod, P, pseudo, # dwindle
bind = $Mod, V, togglesplit, # dwindle
bind = $Shift, N, exec, $netmgr
bind = $Shift, T, exec, $taskmgr
bind = $SuperMod, L, exec, $locker
bind = $Mod, Backspace, exec, $editor
bind = $Mod, F, fullscreen, 1 # maximum current window

# Move focus with Mod + arrow keys
bind = $Mod, H, movefocus, l
bind = $Mod, L, movefocus, r
bind = $Mod, K, movefocus, u
bind = $Mod, J, movefocus, d

# Move Windows with Mod + Shift + arrow keys
bind = $Shift, H, movewindow, l
bind = $Shift, L, movewindow, r
bind = $Shift, K, movewindow, u
bind = $Shift, J, movewindow, d

# Switch workspaces with Mod + [0-9]
bind = $Mod, 1, workspace, 1
bind = $Mod, 2, workspace, 2
bind = $Mod, 3, workspace, 3
bind = $Mod, 4, workspace, 4
bind = $Mod, 5, workspace, 5
bind = $Mod, 6, workspace, 6
bind = $Mod, 7, workspace, 7
bind = $Mod, 8, workspace, 8
bind = $Mod, 9, workspace, 9
bind = $Mod, 0, workspace, 10

# Move active window to a workspace with Mod + SHIFT + [0-9]
bind = $Mod SHIFT, 1, movetoworkspace, 1
bind = $Mod SHIFT, 2, movetoworkspace, 2
bind = $Mod SHIFT, 3, movetoworkspace, 3
bind = $Mod SHIFT, 4, movetoworkspace, 4
bind = $Mod SHIFT, 5, movetoworkspace, 5
bind = $Mod SHIFT, 6, movetoworkspace, 6
bind = $Mod SHIFT, 7, movetoworkspace, 7
bind = $Mod SHIFT, 8, movetoworkspace, 8
bind = $Mod SHIFT, 9, movetoworkspace, 9
bind = $Mod SHIFT, 0, movetoworkspace, 10

# Example special workspace (scratchpad)
bind = $Mod, Slash, togglespecialworkspace, magic
bind = $Shift, Slash, movetoworkspacesilent, special:magic

# Scroll through existing workspaces with Mod + scroll
bind = $Mod, mouse_down, workspace, e+1
bind = $Mod, mouse_up, workspace, e-1

# Move/resize windows with Mod + LMB/RMB and dragging
bindm = $Mod, mouse:272, movewindow
bindm = $Mod, mouse:273, resizewindow

# sets repeatable binds for resizing the active window
bind=$Shift,left,resizeactive,-30 0
bind=$Shift,up,resizeactive,0 -30
bind=$Shift,right,resizeactive,30 0
bind=$Shift,down,resizeactive,0 30

# will switch to a submap called resize
bind=$Shift,R,submap,resize

# will start a submap called "resize"
submap=resize

# sets repeatable binds for resizing the active window
binde=,L,resizeactive,30 0
binde=,H,resizeactive,-30 0
binde=,K,resizeactive,0 -30
binde=,J,resizeactive,0 30

# use reset to go back to the global submap
bind=,escape,submap,reset 

# will reset the submap, meaning end the current one and return to the global one
submap=reset
